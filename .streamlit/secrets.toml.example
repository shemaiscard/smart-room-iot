# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# "Secrets" panel. Simulation mode works without any of these.

# Same value as SMART_ROOM_KEY in the board's secrets.h. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SMART_ROOM_KEY = "CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Password that unlocks the live controls (door, lights, alarm)
DASHBOARD_PASSWORD = "choose-a-strong-password"

# Broker (defaults shown). For a private broker, set its host, port and login.
# MQTT_HOST = "broker.hivemq.com"
# MQTT_PORT = 8883
# MQTT_USE_TLS = "1"
# MQTT_USER = ""
# MQTT_PASS = ""
# TOPIC_BASE = "giscard/smart_room"
